# Anthropic API - pro generování video promptů
ANTHROPIC_API_KEY=sk-ant-...

# Replicate API - pro generování videí
REPLICATE_API_TOKEN=r8_...

# Video model na Replicate (volitelné - default: minimax/video-01)
# Doporučené alternativy:
#   minimax/video-01        (default, 6s/clip, kvalitní)
#   lucataco/kling-v1.6-standard-image-to-video  (alt, 5-10s)
#   wavespeedai/wan-2.1-i2v-480p                 (rychlejší, levnější)
REPLICATE_VIDEO_MODEL=minimax/video-01
